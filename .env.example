# Copy to .env.local for `npm run dev`. Every value below is a local, throwaway example.
SCHEDULING_API_URL=http://localhost:8180
WEBHOOK_RELAY_URL=http://localhost:3100
WEBHOOK_RELAY_ADMIN_KEY=e2e-admin-key-0123456789abcdefghijklmnop
# 32 random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=local-only-session-secret-0123456789abcdef
DATABASE_URL=postgres://dashboard:dashboard@localhost:5435/dashboard
# whsec_ + base64; the relay returns it when the subscription is created.
WEBHOOK_SECRET=whsec_bG9jYWwtb25seS13ZWJob29rLXNlY3JldC0xMjM0NTY3OA==
DEMO_MODE=false
BUSINESS_TIME_ZONE=America/Sao_Paulo
API_TIMEOUT_MS=10000
